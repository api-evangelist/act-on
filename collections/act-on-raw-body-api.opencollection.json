        "type": "http"
      },
      "http": {
        "method": "POST",
        "url": "https://api.actonsoftware.com/api/1/list/:listid/record",
        "params": [
          {
            "name": "listid",
            "value": "",
            "type": "path",
            "description": "Specify the list id"
          }
        ],
        "body": {
          "type": "form-urlencoded",
          "data": [
            {
              "name": "RAW_BODY",
              "value": ""
            }
          ]
        }
      },
      "docs": "Add a contact record to the specified list."
    },
    {
      "info": {
        "name": "Upsert a contact record by email",
        "type": "http"
      },
      "http": {
        "method": "PUT",
        "url": "https://api.actonsoftware.com/api/1/list/:listid/record",
        "params": [
          {
            "name": "listid",
            "value": "",
            "type": "path",
            "description": "Specify the list id"
          },
          {
            "name": "email",
            "value": "",
            "type": "query",
            "description": "Specify the email address"
          }
        ],
        "body": {
          "type": "form-urlencoded",
          "data": [
            {
              "name": "RAW_BODY",
              "value": ""
            }
          ]
        }
      },
      "docs": "Update an existing record or insert a new contact record using the email address that you specify using the following logic: <p>If the email address exists in the list, only the first record matching that email address is updated with the data you provide.</p><p>If the email address is not already in the list, a new record is added.</p><p>Please take note that this means that any duplicate records are NOT updated.</p>"
    },
    {
      "info": {
        "name": "Update a contact by record ID",
        "type": "http"
      },
      "http": {
        "method": "PUT",
        "url": "https://api.actonsoftware.com/api/1/list/:listid/record/:recordid",
        "params": [
          {
            "name": "listid",
            "value": "",
            "type": "path",
            "description": "Specify the list id"
          },
          {
            "name": "recordid",
            "value": "",
            "type": "path",
            "description": "Specify the record id (\"{listid}:{recordid}\")"
          },
          {
            "name": "returncontact",
            "value": "",
            "type": "query",
            "description": "Return the data of the updated contact in the response? <p>(\"Y\"/\"N\")</p>"
          }
        ],
        "body": {
          "type": "form-urlencoded",
          "data": [
            {
              "name": "RAW_BODY",
              "value": ""
            }
          ]
        }
